# 缓存与安全响应头（Cloudflare Pages 与 Netlify 通用格式）
#
# 核心策略：HTML 一律不缓存，交给浏览器每次回源校验；
# 因为游戏是单文件，HTML 就是"首屏+全部逻辑"，缓存住它等于发版不生效。

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

# 版本清单：绝不能被缓存，否则前端轮询永远看不到新版本
/version.json
  Cache-Control: no-store, no-cache, must-revalidate
  Access-Control-Allow-Origin: same-origin

# 入口页与游戏本体：允许缓存但必须回源校验（拿 304 就是最快的情况）
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/xiuxian.html
  Cache-Control: public, max-age=0, must-revalidate

# 纯静态元信息可以短缓存
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

/404.html
  Cache-Control: public, max-age=3600
